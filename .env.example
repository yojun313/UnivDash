ADMIN_USER=
# 12자 이상. 평문 대신 해시를 쓰려면: .venv/bin/python tools/security.py hash-password → ADMIN_PASS_HASH=
ADMIN_PASS=
# ADMIN_PASS_HASH=
# 2단계 인증(강력 권장): .venv/bin/python tools/security.py totp → 인증 앱에 등록 후 아래에 넣기
# ADMIN_TOTP_SECRET=
# 32자 이상 임의 문자열: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
PORT=8000
HOST=127.0.0.1
LOG_LEVEL=info
APP_ENV=production
# HTTPS(리버스 프록시) 뒤에서 운영할 때 true: __Host- 쿠키(Secure) + HSTS + upgrade-insecure-requests
SESSION_HTTPS_ONLY=false
# 접속을 허용할 도메인 (DNS rebinding 차단). 예: dash.example.com,localhost
ALLOWED_HOSTS=
# 로그인 유지: 최대 유지 시간(시간) / 아무 요청 없을 때 만료(분). 기본 12시간 / 240분
# 예) 30일 · 7일 미사용: SESSION_MAX_HOURS=720, SESSION_IDLE_MINUTES=10080 (길게 쓰면 2단계 인증 권장)
# SESSION_MAX_HOURS=12
# SESSION_IDLE_MINUTES=240
# Explorer 가 열 수 있는 폴더 (':' 구분, 기본: 홈 폴더). 이 밖의 경로 · 링크는 막힙니다.
# EXPLORER_ROOTS=/home/user/projects:/srv
# 세션 · 창 정리 · Git 설정 저장 위치 (기본: ~/.univdash/data)
# ⚠️ pm2 watch 를 쓴다면 프로젝트 폴더 안으로 두지 마세요 (파일이 바뀔 때마다 서버가 재시작됨)
# UNIVDASH_DATA_DIR=/home/user/.univdash/data
# 첨부 원본 (기본: ~/.univdash/uploads, 50MB, 24시간 보관 / 0 이면 자동 삭제 안 함)
# 서버 시작 시와 이후 5분마다 만료된 첨부를 삭제합니다. Claude/Codex 대화 로그는 별도입니다.
# UNIVDASH_UPLOAD_DIR=/home/user/.univdash/uploads
# UNIVDASH_UPLOAD_MAX_MB=50
# UNIVDASH_UPLOAD_TTL_DAYS=1

# Git 관리: 저장소를 찾을 상위 폴더들 / 직접 지정할 저장소 (':' 로 구분, 기본은 UnivDash 상위 폴더)
# GIT_REPOSITORY_ROOTS=/home/user
# GIT_REPOSITORIES=/srv/app-one:/srv/app-two
# AI 사용량 기록이 기본 사용자 홈 경로가 아닐 때만 설정
# CLAUDE_DATA_DIR=/home/user/.claude
# CODEX_DATA_DIR=/home/user/.codex
# LOG_TRACEBACK_LOCALS=false
# PM2 ecosystem 파일 (서버 페이지에서 앱 추가/시작, 기본: ~/ecosystem.config.js)
# PM2_ECOSYSTEM_FILE=/home/user/ecosystem.config.js
